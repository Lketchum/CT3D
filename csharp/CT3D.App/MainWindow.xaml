<Window
    x:Class="CT3D.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CT3D Workstation"
    Width="1280"
    Height="860"
    MinWidth="960"
    MinHeight="680"
    Background="#101218">
    <DockPanel Margin="12">
        <Border
            DockPanel.Dock="Top"
            Padding="12"
            Background="#1B1F29"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="OpenSeriesButton"
                    MinWidth="130"
                    Padding="14,8"
                    Click="OpenSeriesButton_Click"
                    Content="打开 DICOM 序列" />

                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Foreground="#E8EAF0"
                        Text="请选择包含轴位 CT 切片的文件夹" />
                    <ProgressBar
                        x:Name="LoadProgress"
                        Width="160"
                        Height="8"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="#E8EAF0"
                        Text="窗宽/窗位" />
                    <ComboBox
                        x:Name="WindowPreset"
                        Width="150"
                        SelectionChanged="WindowPreset_SelectionChanged">
                        <ComboBoxItem Content="骨窗 2000 / 500" Tag="2000,500" />
                        <ComboBoxItem Content="软组织 400 / 40" Tag="400,40" />
                        <ComboBoxItem Content="肺窗 1500 / -600" Tag="1500,-600" />
                    </ComboBox>
                    <TextBlock
                        Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="#E8EAF0"
                        Text="Slab" />
                    <ComboBox
                        x:Name="SlabCombo"
                        Width="56"
                        SelectionChanged="SlabSettings_Changed">
                        <ComboBoxItem Content="1" IsSelected="True" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="7" />
                    </ComboBox>
                    <ComboBox
                        x:Name="SlabModeCombo"
                        Width="72"
                        Margin="8,0,0,0"
                        SelectionChanged="SlabSettings_Changed">
                        <ComboBoxItem Content="mean" IsSelected="True" />
                        <ComboBoxItem Content="mip" />
                    </ComboBox>
                    <TextBlock
                        Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="#E8EAF0"
                        Text="斜面°" />
                    <Slider
                        x:Name="ObliqueAngleSlider"
                        Width="120"
                        Maximum="60"
                        Minimum="0"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="30"
                        ValueChanged="ObliqueAngleSlider_ValueChanged" />
                    <TextBlock
                        x:Name="ObliqueAngleText"
                        Width="36"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#E8EAF0"
                        Text="30°" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            DockPanel.Dock="Bottom"
            Margin="0,12,0,0"
            Padding="12"
            Background="#1B1F29"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#7EC8FF"
                    Text="轴位 Z" />
                <Slider
                    x:Name="SliderZ"
                    Grid.Column="1"
                    Margin="8,0"
                    IsEnabled="False"
                    TickFrequency="1"
                    ValueChanged="LinkedSlider_ValueChanged" />
                <TextBlock
                    x:Name="TextZ"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="0 / 0" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Foreground="#8CFF9A"
                    Text="冠状 Y" />
                <Slider
                    x:Name="SliderY"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,8,8,0"
                    IsEnabled="False"
                    TickFrequency="1"
                    ValueChanged="LinkedSlider_ValueChanged" />
                <TextBlock
                    x:Name="TextY"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="0 / 0" />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Foreground="#FFB86C"
                    Text="矢状 X" />
                <Slider
                    x:Name="SliderX"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="8,8,8,0"
                    IsEnabled="False"
                    TickFrequency="1"
                    ValueChanged="LinkedSlider_ValueChanged" />
                <TextBlock
                    x:Name="TextX"
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="0 / 0" />
            </Grid>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="0,0,6,6"
                Background="Black"
                BorderBrush="#343A49"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Image x:Name="AxialImage" Stretch="Uniform" />
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="#7EC8FF"
                        Text="Axial" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="6,0,0,6"
                Background="Black"
                BorderBrush="#343A49"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Image x:Name="CoronalImage" Stretch="Uniform" />
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="#8CFF9A"
                        Text="Coronal" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,6,6,0"
                Background="Black"
                BorderBrush="#343A49"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Image x:Name="SagittalImage" Stretch="Uniform" />
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="#FFB86C"
                        Text="Sagittal" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="6,6,0,0"
                Background="Black"
                BorderBrush="#343A49"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Image x:Name="ObliqueImage" Stretch="Uniform" />
                    <TextBlock
                        x:Name="EmptyStateText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="#7F8798"
                        Text="MPR + oblique preview" />
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="#E0B0FF"
                        Text="Oblique (trilinear)" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
