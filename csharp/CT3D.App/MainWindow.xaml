<Window
    x:Class="CT3D.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CT3D Workstation"
    Width="1100"
    Height="760"
    MinWidth="760"
    MinHeight="560"
    Background="#101218">
    <DockPanel Margin="16">
        <Border
            DockPanel.Dock="Top"
            Padding="12"
            Background="#1B1F29"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="OpenSeriesButton"
                    MinWidth="130"
                    Padding="14,8"
                    Click="OpenSeriesButton_Click"
                    Content="打开 DICOM 序列" />
                <TextBlock
                    x:Name="StatusText"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="请选择包含轴位 CT 切片的文件夹" />
            </StackPanel>
        </Border>

        <Border
            DockPanel.Dock="Bottom"
            Margin="0,12,0,0"
            Padding="12"
            Background="#1B1F29"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="轴位层：" />
                <Slider
                    x:Name="SliceSlider"
                    Grid.Column="1"
                    Margin="8,0,16,0"
                    IsEnabled="False"
                    TickFrequency="1"
                    ValueChanged="SliceSlider_ValueChanged" />
                <TextBlock
                    x:Name="SliceText"
                    Grid.Column="2"
                    MinWidth="80"
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="0 / 0" />
                <TextBlock
                    Grid.Column="3"
                    Margin="24,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="#E8EAF0"
                    Text="窗宽 / 窗位：" />
                <ComboBox
                    x:Name="WindowPreset"
                    Grid.Column="4"
                    Width="150"
                    SelectionChanged="WindowPreset_SelectionChanged">
                    <ComboBoxItem Content="骨窗 2000 / 500" Tag="2000,500" />
                    <ComboBoxItem Content="软组织 400 / 40" Tag="400,40" />
                    <ComboBoxItem Content="肺窗 1500 / -600" Tag="1500,-600" />
                </ComboBox>
            </Grid>
        </Border>

        <Border
            Margin="0,12,0,0"
            Background="Black"
            BorderBrush="#343A49"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Image
                    x:Name="SliceImage"
                    Stretch="Uniform"
                    SnapsToDevicePixels="True" />
                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="#7F8798"
                    Text="DICOM axial preview" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
